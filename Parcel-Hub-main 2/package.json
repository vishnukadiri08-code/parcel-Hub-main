{
  "name": "campus-parcel-hub-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run start --workspace server\" \"npm run client --workspace client\"",
    "start": "npm run start --workspace server",
    "server": "npm run start --workspace server",
    "client": "npm run client --workspace client",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
